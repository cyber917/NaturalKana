 import SwiftUI
+import AzooKeyUtils
+import NaturalSuggestCore
+import NaturalSuggestUI
 
 @main
 struct MainApp: App {
+    var body: some Scene {
+        WindowGroup {
+            if let error = SharedStore.installationError {
+                VStack(spacing: 16) {
+                    Text("共享权限未就绪").font(.headline)
+                    Text(error).font(.callout)
+                    Text("修正权限后重新打开应用。").font(.caption).foregroundStyle(.secondary)
+                }.padding()
+            } else { InstalledAppRoot() }
+        }
+    }
+}
+
+private struct InstalledAppRoot: View {
+    @MainActor private static var naturalCheckModel: SuggestionModel?
     @StateObject private var router = AppRouter()
     @StateObject private var keyboardConfiguration = KeyboardConfigurationState()
     @StateObject private var onboarding = OnboardingState()
     @StateObject private var reviewPrompt = RequestReviewManager()
     @StateObject private var customizationWalkthrough = CustomizationWalkthroughState()
 
-    var body: some Scene {
-        WindowGroup {
+    var body: some View {
+        Group {
             AppRootView()
                 .environmentObject(router)
                 .environmentObject(keyboardConfiguration)
@@ -18,7 +36,38 @@ struct MainApp: App {
                 .environmentObject(customizationWalkthrough)
                 .onAppear {
                     AppLaunchTasks.performInitialSetup()
+                    Self.runNaturalCheckIfRequested()
                 }
         }
     }
+
+    // Explicit developer checks use the app's own shared settings and Keychain.
+    // Never print draft text, credentials, endpoints, or raw provider replies.
+    @MainActor private static func runNaturalCheckIfRequested() {
+        let arguments = ProcessInfo.processInfo.arguments
+        guard naturalCheckModel == nil,
+              arguments.contains("--check-natural") || arguments.contains(where: { $0.hasPrefix("--natural-provider=") }) else { return }
+        let model = SuggestionModel(); naturalCheckModel = model
+        if let flag = arguments.first(where: { $0.hasPrefix("--natural-provider=") }),
+           let kind = ProviderKind(rawValue: String(flag.dropFirst("--natural-provider=".count))) {
+            model.settings.provider = kind
+            guard model.save() else { print("NATURAL_CHECK: settings could not be saved"); exit(1) }
+        }
+        guard arguments.contains("--check-natural") else { return }
+        model.onStatusChange = { status in
+            switch status {
+            case .idle, .waiting, .requesting: break
+            default:
+                print("NATURAL_CHECK: \(status.message); count=\(model.suggestions.count)")
+                print(model.timingText); fflush(stdout)
+                exit(status == .ready || status == .natural ? 0 : 1)
+            }
+        }
+        let natural = arguments.contains("--natural-draft")
+        model.update(DraftSnapshot(text: natural ? "今日は天気がいいですね。" : "いえいえー clickしたらpasteをできる", fieldID: "device-check"), explicit: true)
+        Task { @MainActor in
+            try? await Task.sleep(for: .seconds(25))
+            print("NATURAL_CHECK: deadline exceeded"); fflush(stdout); exit(2)
+        }
+    }
 }
