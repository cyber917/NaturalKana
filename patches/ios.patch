@@ -0,0 +1,63 @@
+import CustardKit
+
+public enum ExtraKeyboardLayout: String, CaseIterable, Sendable {
+    case korean, french, russian, chinese
+
+    public var identifier: String { rawValue + "_qwerty" }
+    public var symbol: String {
+        switch self {
+        case .korean: "한"
+        case .french: "FR"
+        case .russian: "РУ"
+        case .chinese: "中"
+        }
+    }
+    public var tab: TabData.SystemTab {
+        switch self {
+        case .korean: .qwerty_korean
+        case .french: .qwerty_french
+        case .russian: .qwerty_russian
+        case .chinese: .qwerty_chinese
+        }
+    }
+}
+
+public enum KeyboardSwitchLanguage: String, CaseIterable, Sendable {
+    case japanese, english, korean, french, russian, chinese
+
+    public var symbol: String {
+        switch self {
+        case .japanese: "あ"
+        case .english: "A"
+        case .korean: "한"
+        case .french: "FR"
+        case .russian: "РУ"
+        case .chinese: "中"
+        }
+    }
+    public var title: String {
+        switch self {
+        case .japanese: "日本語"
+        case .english: "English"
+        case .korean: "한국어"
+        case .french: "Français"
+        case .russian: "Русский"
+        case .chinese: "中文"
+        }
+    }
+    public var tab: TabData.SystemTab {
+        switch self {
+        case .japanese: .user_japanese
+        case .english: .user_english
+        case .korean: .qwerty_korean
+        case .french: .qwerty_french
+        case .russian: .qwerty_russian
+        case .chinese: .qwerty_chinese
+        }
+    }
+    public static func next(after current: Self?, order: [Self]) -> Self {
+        guard !order.isEmpty else { return .japanese }
+        guard let current, let index = order.firstIndex(of: current) else { return order[0] }
+        return order[(index + 1) % order.count]
+    }
+}
