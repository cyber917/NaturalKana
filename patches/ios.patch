+            case .idle, .waiting, .requesting: break
+            default:
+                print("NATURAL_CHECK: \(status.message); count=\(model.suggestions.count)")
+                print(model.timingText); fflush(stdout)
+                exit(status == .ready || status == .natural ? 0 : 1)
+            }
+        }
+        let natural = arguments.contains("--natural-draft")
+        model.update(DraftSnapshot(text: natural ? "今日は天気がいいですね。" : "いえいえー clickしたらpasteをできる", fieldID: "device-check"), explicit: true)
+        Task { @MainActor in
+            try? await Task.sleep(for: .seconds(25))
+            print("NATURAL_CHECK: deadline exceeded"); fflush(stdout); exit(2)
+        }
+    }
 }
