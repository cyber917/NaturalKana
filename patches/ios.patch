+import CustardKit
+@testable import KeyboardViews
+import XCTest
+
+final class ExtraKeyboardLayoutTests: XCTestCase {
+    func testEveryOrderedSelectionCyclesAndMenuKeepsOtherLanguagesReachable() {
+        func check(_ order: [KeyboardSwitchLanguage], remaining: [KeyboardSwitchLanguage]) {
+            if !order.isEmpty {
+                var current = order[0]
+                var visited = [current]
+                for _ in 1..<order.count {
+                    current = KeyboardSwitchLanguage.next(after: current, order: order)
+                    visited.append(current)
+                }
+                XCTAssertEqual(visited, order)
+                XCTAssertEqual(KeyboardSwitchLanguage.next(after: current, order: order), order[0])
+                XCTAssertEqual(KeyboardSwitchLanguage.next(after: nil, order: order), order[0])
+                for outside in remaining {
+                    XCTAssertEqual(KeyboardSwitchLanguage.next(after: outside, order: order), order[0])
+                }
+            }
+            for language in remaining {
+                check(order + [language], remaining: remaining.filter { $0 != language })
+            }
+        }
+        check([], remaining: KeyboardSwitchLanguage.allCases)
+        XCTAssertEqual(KeyboardSwitchLanguage.next(after: nil, order: []), .japanese)
+    }
+
+    func testEnglishUsesStandardRowsAndSystemKeys() {
+        let custard = Custard.qwertyEnglish(useShiftKey: true, useDeprecatedShiftKeyBehavior: false)
+        XCTAssertEqual(custard.language, .en_US)
+        XCTAssertEqual(custard.input_style, .direct)
+        for (row, letters, offset) in [(0, "qwertyuiop", 0.0), (1, "asdfghjkl", 0.5), (2, "zxcvbnm", 1.5)] {
+            for (index, letter) in letters.enumerated() {
+                let position = CustardKeyPositionSpecifier.gridFit(.init(x: offset + Double(index), y: Double(row), width: 1, height: 1))
+                guard case let .custom(key) = custard.interface.keys[position] else { return XCTFail("Missing letter key") }
+                XCTAssertEqual(key.press_actions, [.input(String(letter))])
+            }
+        }
+        let shift = CustardKeyPositionSpecifier.gridFit(.init(x: 0, y: 2, width: 1.4, height: 1))
+        let language = CustardKeyPositionSpecifier.gridFit(.init(x: 1.4, y: 3, width: 1.4, height: 1))
+        XCTAssertEqual(custard.interface.keys[shift], .system(.qwertyShift))
+        XCTAssertEqual(custard.interface.keys[language], .system(.qwertyLanguageSwitch))
+        let withoutShift = Custard.qwertyEnglish(useShiftKey: false)
+        XCTAssertEqual(withoutShift.interface.keys[shift], .system(.upperLower))
+    }
+
+    func testChineseLayoutTypesLowercasePinyin() {
+        let custard = Custard.qwertyChinese
+        XCTAssertEqual(custard.identifier, ExtraKeyboardLayout.chinese.identifier)
+        XCTAssertEqual(custard.language, .none)
+        XCTAssertEqual(custard.input_style, .direct)
+        var inputs: Set<String> = []
+        for key in custard.interface.keys.values {
+            guard case let .custom(key) = key else { continue }
+            for action in key.press_actions + key.variations.flatMap({ $0.key.press_actions }) {
+                if case let .input(value) = action { inputs.insert(value) }
+            }
+        }
+        for letter in "abcdefghijklmnopqrstuvwxyz" { XCTAssertTrue(inputs.contains(String(letter)), "Missing \(letter)") }
+        XCTAssertEqual(inputs.count, 26, "Only lowercase letters, like the iOS pinyin keyboard")
+        var punctuation: Set<String> = []
+        for key in Custard.qwertyChineseNumbers.interface.keys.values {
+            guard case let .custom(key) = key else { continue }
+            for case let .input(value) in key.press_actions { punctuation.insert(value) }
+        }
+        XCTAssertTrue(punctuation.isSuperset(of: ["，", "。", "、", "？", "！", "：", "；", "1", "0"]))
+        XCTAssertTrue(KeyboardTab.ExistentialTab.custard(.qwertyChineseNumbers).isQwertyNumberOrSymbol)
+    }
+
+    func testLayoutsContainEveryLetterAndVariant() {
+        for (custard, alphabet) in [(Custard.qwertyFrench, "abcdefghijklmnopqrstuvwxyzàâæéèêëîïôœùûüçÿ"),
+                                    (Custard.qwertyRussian, "абвгдеёжзийклмнопрстуфхцчшщъыьэюя")] {
+            XCTAssertEqual(custard.language, .none)
+            XCTAssertEqual(custard.input_style, .direct)
+            var inputs: Set<String> = []
+            for key in custard.interface.keys.values {
+                guard case let .custom(key) = key else { continue }
+                for action in key.press_actions + key.variations.flatMap({ $0.key.press_actions }) {
+                    if case let .input(value) = action { inputs.insert(value) }
+                }
+                if !key.variations.isEmpty {
+                    XCTAssertEqual(key.variations.first?.key.press_actions, key.press_actions)
+                }
+            }
+            for character in alphabet {
+                XCTAssertTrue(inputs.contains(String(character)), "Missing \(character)")
+                XCTAssertTrue(inputs.contains(String(character).uppercased()), "Missing uppercase \(character)")
+            }
+            let positions = custard.interface.keys.keys.compactMap { key -> GridFitPositionSpecifier? in
+                if case let .gridFit(position) = key { return position }; return nil
+            }
+            for position in positions {
+                XCTAssertGreaterThanOrEqual(position.x, 0)
+                XCTAssertLessThanOrEqual(position.x + position.width, 10.0001)
+                XCTAssertGreaterThan(position.width, 0)
+            }
+            for row in 0...3 {
+                let ordered = positions.filter { $0.y == Double(row) }.sorted { $0.x < $1.x }
+                for (left, right) in zip(ordered, ordered.dropFirst()) {
+                    XCTAssertLessThanOrEqual(left.x + left.width, right.x + 0.0001)
+                }
+            }
+        }
+    }
+}
