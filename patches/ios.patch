+        var keys: [CustardKeyPositionSpecifier: CustardInterfaceKey] = [:]
+        for (row, letters) in rows.enumerated() {
+            let availableWidth = row == 2 ? 7.2 : 10.0
+            let width = availableWidth / Double(letters.count)
+            let offset = row == 2 ? 1.4 : 0.0
+            for (index, character) in letters.enumerated() {
+                let letter = String(character)
+                let forms = [letter] + (variants[letter] ?? "").map(String.init)
+                keys[position(offset + Double(index) * width, row, width: width)] = inputKey(letter, variations: forms + forms.map { $0.uppercased() })
+            }
+        }
+        keys[position(0, 2, width: 1.4)] = .system(.qwertyLanguageSwitch)
+        keys[position(8.6, 2, width: 1.4)] = deleteKey
+        addBottomRow(to: &keys, leadingKey: tabKey(label: .systemImage("textformat.123"), destination: .qwerty_numbers))
+        return custard(identifier: identifier, displayName: displayName, language: .none, inputStyle: .direct, keys: keys)
+    }
