<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NaturalKana.Windows</RootNamespace>
    <AssemblyName>NaturalKana</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.4</Version>
    <Product>NaturalKana for Windows</Product>
    <Copyright>NaturalKana contributors</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Shared with the iPhone/Mac builds so all platforms use the same language packs and interface text. -->
  <ItemGroup>
    <!-- One folder per suggestion language: language.json, prompt.txt, optional lexicon.jsonl. -->
    <EmbeddedResource Include="..\..\NaturalSuggestCore\Sources\NaturalSuggestCore\Resources\Languages\**\*" LogicalName="Languages/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\NaturalSuggestCore\Sources\NaturalSuggestCore\Resources\ui_strings.json" LogicalName="ui_strings.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NaturalKana.Windows.Tests" />
    <!-- WinForms is only used for the tray icon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
