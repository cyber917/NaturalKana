<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NaturalKana.Windows</RootNamespace>
    <AssemblyName>NaturalKana</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>NaturalKana for Windows</Product>
    <Copyright>NaturalKana contributors</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Shared with the iPhone/Mac builds so all platforms use the same prompts and lexicon. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\NaturalSuggestCore\Sources\NaturalSuggestCore\Resources\Prompts\system_v1.txt" LogicalName="system_v1.txt" />
    <EmbeddedResource Include="..\..\NaturalSuggestCore\Sources\NaturalSuggestCore\Resources\Prompts\english_v1.txt" LogicalName="english_v1.txt" />
    <EmbeddedResource Include="..\..\NaturalSuggestCore\Sources\NaturalSuggestCore\Resources\slang.jsonl" LogicalName="slang.jsonl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NaturalKana.Windows.Tests" />
    <!-- WinForms is only used for the tray icon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
