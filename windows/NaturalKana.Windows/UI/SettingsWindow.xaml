<Window x:Class="NaturalKana.Windows.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NaturalKana 设置" Width="620" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#1D1D1F">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6E6E73"/>
            <Setter Property="Margin" Value="18,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="130"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,9"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E5E5EA"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0071E3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="20,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#0071E3"/>
            <Setter Property="Background" Value="#E8F0FC"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,24">
            <TextBlock Text="NaturalKana" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="Intro" Margin="0,6,0,22" Foreground="#6E6E73" TextWrapping="Wrap"/>

            <TextBlock Text="服务商" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="服务商" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="接口地址" Style="{StaticResource Label}"/>
                        <Button DockPanel.Dock="Right" Content="恢复默认" Margin="8,0,0,0" Padding="8,2" Click="OnResetUrl"
                                Background="Transparent" BorderThickness="0" Foreground="#0071E3" Cursor="Hand"/>
                        <TextBox x:Name="UrlBox"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="API 模型 ID" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ModelBox" ToolTip="从服务商控制台复制 API 模型 ID，不是聊天界面的显示名"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="API 密钥" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="KeyState" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6E6E73"/>
                        <PasswordBox x:Name="KeyBox" ToolTip="留空则保留已保存的密钥"/>
                    </DockPanel>
                    <Border x:Name="ThinkingDivider" Style="{StaticResource Divider}"/>
                    <DockPanel x:Name="ThinkingRow" Style="{StaticResource Row}">
                        <TextBlock Text="非思考模式" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="ThinkingBox" VerticalAlignment="Center" Content="关闭深度思考，更快（所选 Qwen 模型需支持）"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="建议" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="建议语言" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged"/>
                    </DockPanel>
                    <StackPanel x:Name="PrimaryRow" Visibility="Collapsed">
                        <Border Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="主要语言" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="PrimaryBox" ToolTip="分不清是哪种语言时（例如只有汉字的短句），按这个语言处理"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="语体" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="RegisterBox"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="网络用语" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SlangBox"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="方言" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="DialectBox"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="建议上限" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CountBox" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="标出改动" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="HighlightBox" VerticalAlignment="Center" Content="用蓝色标出和原句不同的部分"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="使用" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="界面语言" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="InterfaceBox" SelectionChanged="OnInterfaceChanged"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="检查当前文字" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                        <StackPanel>
                            <TextBox x:Name="HotkeyBox" Width="200" HorizontalAlignment="Left" IsReadOnly="True" Cursor="Hand"
                                     IsReadOnlyCaretVisible="False" InputMethod.IsInputMethodEnabled="False"/>
                            <TextBlock x:Name="HotkeyHint" Margin="0,5,0,0" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Text="点一下，再按新的组合键"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="全选输入框并检查" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                        <StackPanel>
                            <TextBox x:Name="SelectAllHotkeyBox" Width="200" HorizontalAlignment="Left" IsReadOnly="True" Cursor="Hand"
                                     IsReadOnlyCaretVisible="False" InputMethod.IsInputMethodEnabled="False"/>
                            <TextBlock x:Name="SelectAllHotkeyHint" Margin="0,5,0,0" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Text="点一下，再按新的组合键"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="没选中文字时" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ScopeBox"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="每日请求上限" Style="{StaticResource Label}"/>
                        <TextBox x:Name="CapBox" Width="90" HorizontalAlignment="Left" ToolTip="0 表示不限；这不是服务商的费用上限"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="自动建议" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel>
                            <CheckBox x:Name="AutoBox" Content="停顿后自动给出建议（实验性）"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="停顿" VerticalAlignment="Center" Foreground="#6E6E73"/>
                                <ComboBox x:Name="PauseBox" Width="110" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap"
                                       Text="只在能读取输入框内容的软件里生效（记事本、Word、浏览器等）；微信等软件读不到时请用快捷键。每次停顿都可能请求一次，受每日上限限制。"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="开机启动" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="StartupBox" VerticalAlignment="Center" Content="登录 Windows 后自动在后台运行"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="ConsentBox" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <TextBlock TextWrapping="Wrap" Margin="8,0,0,0">允许把选中的那一句（最多 200 字）发送给上面配置的服务商。<Run Foreground="#6E6E73">本程序没有服务器，不保存草稿。</Run></TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Expander Header="高级（接口不兼容时再调整）" Margin="0,0,0,18" Foreground="#6E6E73">
                <Border Style="{StaticResource Section}" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="协议" Style="{StaticResource Label}" Foreground="#1D1D1F"/>
                            <ComboBox x:Name="ProtocolBox"/>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="JSON 格式" Style="{StaticResource Label}" Foreground="#1D1D1F"/>
                            <ComboBox x:Name="ResponseBox"/>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="输出长度参数" Style="{StaticResource Label}" Foreground="#1D1D1F"/>
                            <ComboBox x:Name="TokenBox"/>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="删除密钥" Style="{StaticResource Label}" Foreground="#1D1D1F"/>
                            <Button Content="删除当前服务商的已保存密钥" HorizontalAlignment="Left" Click="OnDeleteKey"
                                    Background="Transparent" BorderThickness="0" Foreground="#C93400" Cursor="Hand"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <TextBlock x:Name="Result" TextWrapping="Wrap" Margin="2,0,0,14" Foreground="#6E6E73"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource Secondary}" Margin="0,0,10,0" Click="OnTest"/>
                <Button Content="保存" Style="{StaticResource Primary}" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
